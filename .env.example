# Hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hosted database. Runtime and protected production migration/verify use the
# same Supabase Transaction Pooler DATABASE_URL; do not maintain a second
# production database password variable.
DATABASE_URL=

# Staging remains isolated and composes its own fixed target URL from this
# operational credential rather than inheriting the application's DATABASE_URL.
RIVALHUB_STAGING_DB_PASSWORD=

# Application sessions and standard first-owner bootstrap
ADMIN_SESSION_SECRET=at-least-32-chars-random-secret-here
RIVALHUB_OWNER_EMAIL=owner@example.edu.cn

# Public application origin and Cron authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep this equal to Hosted Supabase Auth's auth.email.max_frequency.
NEXT_PUBLIC_AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
CRON_SECRET=your-cron-secret

# Optional Turnstile: site key may be public; secret key must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional integrations; all are server-only.
STEAM_API_KEY=
OCR_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=
SILICONFLOW_MODEL=

# Optional server-side OTLP sink; configure distinct values in Preview and Production.
# Development and test keep external telemetry disabled by default.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=
