# Hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hosted database. Obtain the current, environment-appropriate connection string from the target Supabase Dashboard.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Application sessions and standard first-owner bootstrap
ADMIN_SESSION_SECRET=at-least-32-chars-random-secret-here
RIVALHUB_OWNER_EMAIL=owner@example.edu.cn

# Legacy emergency Root compatibility path; keep server-only and configure only when this path is required.
RIVALHUB_ROOT_USERNAME=
RIVALHUB_ROOT_PASSWORD=

# Public application origin and Cron authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-secret

# Optional Turnstile: site key may be public; secret key must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional integrations; all are server-only.
STEAM_API_KEY=
OCR_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=
SILICONFLOW_MODEL=
