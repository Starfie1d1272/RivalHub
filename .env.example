# Hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hosted database. The runtime uses a Supabase Transaction Pooler connection.
# Copy the exact target-project value from the Supabase Dashboard; do not guess the pooler hostname.
DATABASE_URL=

# Application sessions and standard first-owner bootstrap
ADMIN_SESSION_SECRET=at-least-32-chars-random-secret-here
RIVALHUB_OWNER_EMAIL=owner@example.edu.cn

# Public application origin and Cron authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-secret

# Optional Turnstile: site key may be public; secret key must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional integrations; all are server-only.
STEAM_API_KEY=
OCR_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=
SILICONFLOW_MODEL=
