#!/usr/bin/env bash
set -euo pipefail

# The pinned CLI's legacy start omits its catalog's digest-preserving ECR mirror.
args=()
for arg in "$@"; do
  if [[ "$arg" =~ ^ghcr\.io/supabase/cli/[a-z0-9-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$ ]]; then
    arg="public.ecr.aws/supabase/cli/${arg#ghcr.io/supabase/cli/}"
  fi
  args+=("$arg")
done
exec "${RIVALHUB_CI_DOCKER_BINARY:?Missing original Docker binary}" "${args[@]}"
