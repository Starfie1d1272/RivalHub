        },
        "matchMapId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "mapOrder": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 5
