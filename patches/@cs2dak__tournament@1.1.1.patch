+import { collectPerformanceAccumulator, finalizePerformanceAccumulator, } from "./performance.js";
+export const TOURNAMENT_PERFORMANCE_PROJECTION_VERSION = 1;
+function fail(message) {
+    throw new Error(`Invalid TournamentPerformanceMapProjection: ${message}`);
+}
+// Stable wire schemas replace repeated quantity field names, not quantities.
+// Their order is part of PROJECTION_VERSION; changing it requires a new version.
+const QUANTITY_SCHEMAS = [
+    ["combat", ["kills", "deaths", "assists", "damage", "headshots", "twoKillRounds", "threeKillRounds", "fourKillRounds", "fiveKillRounds"]],
+    ["opening", ["firstKills", "firstDeaths", "roundWinsAfterWinningOpeningDuel", "roundWinsAfterLosingOpeningDuel"]],
+    ["trade", ["tradeKills", "tradedDeaths", "tradedOpeningDeaths", "deaths"]],
+    ["utility", ["flashesThrown", "enemyBlindSeconds", "teamBlindSeconds", "enemyBlindVictims", "flashAssists", "heThrows", "heDamage", "fireThrows", "fireDamage", "smokesThrown", "utilityKills", "utilityDamage"]],
+    ["objective", ["plants", "defuses", "plantsConverted", "knownPlantOpportunities"]],
+    ["clutch", ["attempts", "wins", ...["1", "2", "3", "4", "5"].flatMap((key) => [`byOpponentCount.${key}.successes`, `byOpponentCount.${key}.attempts`])]],
+];
+function freeze(value, field = "") {
+    if (value === null || typeof value === "string" || typeof value === "number")
+        return value;
+    if (value instanceof Set) {
+        if (field === "roundKeys" || field === "roundsWithOpening") {
+            return { rounds: [...value].map((key) => Number(key.slice(key.lastIndexOf("\u0000") + 1))) };
+        }
+        return { set: [...value].map((item) => freeze(item)) };
+    }
+    if (value instanceof Map)
+        return { entries: [...value].map(([key, item]) => [key, freeze(item)]) };
+    if (typeof value !== "object" || value === undefined || Array.isArray(value))
+        fail("unsupported accumulator value");
+    const schemaIndex = QUANTITY_SCHEMAS.findIndex(([name]) => name === field);
+    if (schemaIndex >= 0) {
+        const fields = QUANTITY_SCHEMAS[schemaIndex][1];
+        return { q: [schemaIndex, ...fields.map((path) => path.split(".").reduce((row, key) => row[key], value))] };
+    }
+    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, freeze(item, key)]));
+}
+function thaw(value, mapKey) {
+    if (value === null || typeof value === "string")
+        return value;
+    if (typeof value === "number") {
+        if (!Number.isFinite(value) || value < 0)
+            fail("accumulator quantities must be finite and non-negative");
+        return value;
+    }
+    if (!value || Array.isArray(value))
+        fail("invalid accumulator object");
+    if (Object.keys(value).length === 1 && Array.isArray(value.q)) {
+        const quantities = value.q;
+        const index = quantities[0];
+        if (typeof index !== "number" || !Number.isInteger(index) || !QUANTITY_SCHEMAS[index])
+            fail("unknown quantity schema");
+        const fields = QUANTITY_SCHEMAS[index][1];
+        if (quantities.length !== fields.length + 1)
+            fail("incomplete quantities");
+        const result = {};
+        fields.forEach((path, offset) => {
+            const quantity = quantities[offset + 1];
+            if (typeof quantity !== "number" || !Number.isFinite(quantity) || quantity < 0)
+                fail("invalid quantity");
+            const keys = path.split(".");
+            const last = keys.pop();
+            let target = result;
+            for (const key of keys)
+                target = (target[key] ??= {});
+            target[last] = quantity;
+        });
+        return result;
+    }
+    if (Object.keys(value).length === 1 && Array.isArray(value.rounds)) {
+        if (value.rounds.some((round) => typeof round !== "number" || !Number.isInteger(round) || round <= 0))
+            fail("invalid round sequence");
+        if (new Set(value.rounds).size !== value.rounds.length)
+            fail("duplicate round sequence");
+        return new Set(value.rounds.map((round) => `${mapKey}\u0000${round}`));
+    }
+    if (Object.keys(value).length === 1 && Array.isArray(value.set)) {
+        if (value.set.some((item) => typeof item !== "string" || !item))
+            fail("invalid identity set");
+        if (new Set(value.set).size !== value.set.length)
+            fail("duplicate identity");
+        return new Set(value.set);
+    }
+    if (Object.keys(value).length === 1 && Array.isArray(value.entries)) {
+        const entries = value.entries.map((entry) => {
+            if (!Array.isArray(entry) || entry.length !== 2 || typeof entry[0] !== "string" || !entry[0])
+                fail("invalid keyed accumulator");
+            return [entry[0], thaw(entry[1], mapKey)];
+        });
+        if (new Set(entries.map(([key]) => key)).size !== entries.length)
+            fail("duplicate accumulator key");
+        return new Map(entries);
+    }
+    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, thaw(item, mapKey)]));
+}
+function restore(projection) {
+    if (projection.version !== TOURNAMENT_PERFORMANCE_PROJECTION_VERSION)
+        fail("unsupported version");
+    for (const field of ["mapKey", "matchKey", "mapName", "semanticProfile", "analysisVersion"]) {
+        if (typeof projection[field] !== "string" || !projection[field])
+            fail(`missing ${field}`);
+    }
+    const stored = thaw(projection.data, projection.mapKey);
+    if (!(stored.players instanceof Map) || !(stored.teams instanceof Map) || !(stored.teamOpenings instanceof Map))
+        fail("invalid entity accumulators");
+    const teamKeys = Object.values(projection.teamEntityKeys);
+    if (teamKeys.length !== 2 || new Set(teamKeys).size !== 2 || teamKeys.some((key) => typeof key !== "string" || !key || !stored.teams.has(key))
+        || stored.teams.size !== 2)
+        fail("invalid map teams");
+    const mapKeys = new Set([projection.mapKey]);
+    const matchKeys = new Set([projection.matchKey]);
+    const state = {
+        ...stored,
+        mapKeys,
+        matchKeys,
+        semanticProfile: projection.semanticProfile,
+        analysisVersions: new Set([projection.analysisVersion]),
+        maps: new Map([[projection.mapName, { mapKeys, matchKeys, shared: stored.global, opening: stored.globalOpening }]]),
+        globalWeapons: new Map(),
+    };
+    for (const team of state.teams.values()) {
+        team.mapKeys = new Set(mapKeys);
+        team.matchKeys = new Set(matchKeys);
+        team.weapons = new Map();
+    }
+    for (const player of state.players.values()) {
+        player.mapKeys = new Set(mapKeys);
+        player.matchKeys = new Set(matchKeys);
+        if (!(player.teamEntityKeys instanceof Set) || player.teamEntityKeys.size !== 1 || !(player.weapons instanceof Map))
+            fail("invalid player accumulator");
+        const team = state.teams.get([...player.teamEntityKeys][0]);
+        if (!team)
+            fail("unknown player team");
+        team.weapons = merge(team.weapons, structuredClone(player.weapons));
+        state.globalWeapons = merge(state.globalWeapons, structuredClone(player.weapons));
+    }
+    return state;
+}
+/** Merge counters, union sample identities, and merge weapon/player buckets. */
+function merge(left, right) {
+    if (typeof left === "number" && typeof right === "number")
+        return (left + right);
+    if (left instanceof Set && right instanceof Set)
+        return new Set([...left, ...right]);
+    if (left instanceof Map && right instanceof Map) {
+        const result = new Map(left);
+        for (const [key, value] of right)
+            result.set(key, result.has(key) ? merge(result.get(key), value) : value);
+        return result;
+    }
+    if (left === null)
+        return right;
+    if (left === right)
+        return left;
+    if (typeof left === "object" && left !== null && typeof right === "object" && right !== null) {
+        return Object.fromEntries(Object.entries(left).map(([key, value]) => [key, merge(value, right[key])]));
+    }
+    fail("incompatible accumulators");
+}
+/** Omit single-map metadata and repeated map/weapon aggregates on the wire. */
+function pack(state) {
+    return freeze({
+        global: state.global,
+        globalOpening: state.globalOpening,
+        players: new Map([...state.players].map(([key, player]) => [key, {
+                teamEntityKeys: player.teamEntityKeys,
+                slices: player.slices,
+                weapons: player.weapons,
+            }])),
+        teams: new Map([...state.teams].map(([key, team]) => [key, { slices: team.slices }])),
+        teamOpenings: state.teamOpenings,
+    });
+}
+/** Validate frozen facts once, then retain the existing DAK raw accumulators. */
+export function collectTournamentPerformanceMapProjection(facts) {
+    const state = collectPerformanceAccumulator([facts]);
+    return {
+        version: TOURNAMENT_PERFORMANCE_PROJECTION_VERSION,
+        semanticProfile: facts.semanticProfile,
+        analysisVersion: facts.analysisVersion,
+        mapKey: facts.mapKey,
+        matchKey: facts.matchKey,
+        mapName: facts.mapName,
+        teamEntityKeys: { ...facts.teamEntityKeys },
+        data: pack(state),
+    };
+}
+/** Finalize with the same owner used by the player-round input API. */
+export function buildTournamentPerformanceAnalyticsFromProjections(projections, options = {}) {
+    let merged = collectPerformanceAccumulator([]);
+    for (const projection of [...projections].sort((a, b) => a.mapKey < b.mapKey ? -1 : a.mapKey > b.mapKey ? 1 : 0)) {
+        const state = restore(projection);
+        if (merged.mapKeys.has(projection.mapKey))
+            fail(`duplicate mapKey ${projection.mapKey}`);
+        if (merged.semanticProfile !== null && merged.semanticProfile !== projection.semanticProfile)
+            fail("mixed semantic profile");
+        merged = merge(merged, state);
+    }
+    return finalizePerformanceAccumulator(merged, options);
+}
+/** Remapping is explicit and cannot collapse two identities within one map. */
+export function remapTournamentPerformanceMapProjection(projection, remap) {
+    const state = restore(projection);
+    const teams = new Map([...state.teams.keys()].map((key) => [key, remap.teamEntityKey(key)]));
+    const players = new Map([...state.players].map(([key, player]) => [key, remap.playerEntityKey(key, [...player.teamEntityKeys][0])]));
+    for (const identities of [teams, players]) {
+        if ([...identities.values()].some((key) => typeof key !== "string" || !key)
+            || new Set(identities.values()).size !== identities.size)
+            fail("remap must preserve distinct non-empty identities within a map");
+    }
+    const remapKeys = (values, identities) => new Map([...values].map(([key, value]) => [identities.get(key) ?? key, value]));
+    const remapWeapons = (weapons) => {
+        for (const weapon of weapons.values()) {
+            weapon.players = remapKeys(weapon.players, players);
+            weapon.teamEntityKeys = new Set([...weapon.teamEntityKeys].map((key) => teams.get(key)));
+        }
+    };
+    for (const player of state.players.values()) {
+        player.teamEntityKeys = new Set([...player.teamEntityKeys].map((key) => teams.get(key)));
+        remapWeapons(player.weapons);
+    }
+    for (const team of state.teams.values())
+        remapWeapons(team.weapons);
+    remapWeapons(state.globalWeapons);
+    state.players = remapKeys(state.players, players);
+    state.teams = remapKeys(state.teams, teams);
+    state.teamOpenings = remapKeys(state.teamOpenings, teams);
+    return {
+        ...projection,
+        teamEntityKeys: { teamA: teams.get(projection.teamEntityKeys.teamA), teamB: teams.get(projection.teamEntityKeys.teamB) },
+        data: pack(state),
+    };
+}
+/**
+ * Scope contributions after complete-map validation. Opening duels remain
+ * valid even though only one team's contribution is retained. Opponent team
+ * identities/map participation stay present, with zero performance samples.
+ */
+export function scopeTournamentPerformanceMapProjectionToTeam(projection, teamEntityKey) {
+    const state = restore(projection);
+    const selected = state.teams.get(teamEntityKey);
+    if (!selected)
+        fail("team does not belong to map");
+    state.players = new Map([...state.players].filter(([, player]) => player.teamEntityKeys.has(teamEntityKey)));
+    const empty = collectPerformanceAccumulator([{ ...projection, playerRounds: [], objectives: [], playerWeapons: [] }]);
+    for (const [key, team] of state.teams)
+        if (key !== teamEntityKey)
+            state.teams.set(key, empty.teams.get(key));
+    state.global = selected.slices.overall;
+    state.globalOpening = state.teamOpenings.get(teamEntityKey) ?? empty.globalOpening;
+    state.globalWeapons = selected.weapons;
+    state.teamOpenings = new Map([[teamEntityKey, state.globalOpening]]);
+    const map = state.maps.get(projection.mapName);
+    map.shared = state.global;
+    map.opening = state.globalOpening;
+    return { ...projection, data: pack(state) };
+}
