+import type { TournamentEntityLabels, TournamentPerformanceAnalytics, TournamentPerformanceMapFacts, TournamentTeamSlot } from "./types.js";
+export declare const TOURNAMENT_PERFORMANCE_PROJECTION_VERSION: 1;
+type ProjectionValue = string | number | null | ProjectionValue[] | {
+    [key: string]: ProjectionValue;
+};
+/**
+ * A JSON-safe, versioned single-map sufficient accumulator. It contains no
+ * player-round facts or display rates. `data` is owned by this package; consumers
+ * persist it verbatim and use the public scope/remap/aggregation operations.
+ * Round sets contain local sequence numbers, never repeated map identifiers.
+ */
+export interface TournamentPerformanceMapProjection {
+    version: typeof TOURNAMENT_PERFORMANCE_PROJECTION_VERSION;
+    semanticProfile: string;
+    analysisVersion: string;
+    mapKey: string;
+    matchKey: string;
+    mapName: string;
+    teamEntityKeys: Record<TournamentTeamSlot, string>;
+    data: ProjectionValue;
+}
+/** Validate frozen facts once, then retain the existing DAK raw accumulators. */
+export declare function collectTournamentPerformanceMapProjection(facts: TournamentPerformanceMapFacts): TournamentPerformanceMapProjection;
+/** Finalize with the same owner used by the player-round input API. */
+export declare function buildTournamentPerformanceAnalyticsFromProjections(projections: readonly TournamentPerformanceMapProjection[], options?: {
+    labels?: TournamentEntityLabels;
+}): TournamentPerformanceAnalytics;
+export interface TournamentPerformanceIdentityRemap {
+    teamEntityKey: (teamEntityKey: string) => string;
+    playerEntityKey: (playerEntityKey: string, teamEntityKey: string) => string;
+}
+/** Remapping is explicit and cannot collapse two identities within one map. */
+export declare function remapTournamentPerformanceMapProjection(projection: TournamentPerformanceMapProjection, remap: TournamentPerformanceIdentityRemap): TournamentPerformanceMapProjection;
+/**
+ * Scope contributions after complete-map validation. Opening duels remain
+ * valid even though only one team's contribution is retained. Opponent team
+ * identities/map participation stay present, with zero performance samples.
+ */
+export declare function scopeTournamentPerformanceMapProjectionToTeam(projection: TournamentPerformanceMapProjection, teamEntityKey: string): TournamentPerformanceMapProjection;
+export {};
